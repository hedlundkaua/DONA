// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PerfilUsuario {
  ADMINISTRADOR
  GESTOR
  ESTOQUISTA
  VENDEDOR
  FINANCEIRO

  @@map("perfil_usuario")
}

enum StatusNegocio {
  ATIVO
  QUARENTENA

  @@map("status_negocio")
}

enum FinalidadeOtp {
  VERIFICAR_EMAIL
  RECUPERAR_SENHA

  @@map("finalidade_otp")
}

model Negocio {
  id          String       @id @default(uuid()) @db.Uuid
  status      StatusNegocio @default(ATIVO)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  usuarios    Usuario[]
  sessoes     SessaoUsuario[]
  auditorias  AuditoriaUsuario[]
  categorias  CategoriaProduto[]
  produtos    Produto[]
  movimentos  MovimentacaoEstoque[]
  ajustes     AjusteInventario[]
  clientes    Cliente[]
  vendas      Venda[]
  itensVenda  ItemVenda[]
  codigosOtp  CodigoOtp[]
  categoriasLegacy CategoriaNomeLegacy[]

  @@map("negocios")
}

model Usuario {
  id          Int           @id @default(autoincrement())
  negocioId   String        @map("negocio_id") @db.Uuid
  nome        String        @db.VarChar(150)
  nomeUsuario String        @unique @map("nome_usuario") @db.VarChar(50)
  email       String        @unique @db.VarChar(254)
  senhaHash   String        @map("senha_hash") @db.VarChar(100)
  perfil      PerfilUsuario
  ativo       Boolean       @default(true)
  emailVerificadoEm DateTime? @map("email_verificado_em") @db.Timestamptz(3)
  authVersion Int @default(0) @map("auth_version")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  sessoes     SessaoUsuario[]
  auditorias  AuditoriaUsuario[] @relation("AuditActor")
  alvos       AuditoriaUsuario[] @relation("AuditTarget")
  vendas      Venda[]
  clientesCriados Cliente[] @relation("ClienteCriadoPor")
  clientesAtualizados Cliente[] @relation("ClienteAtualizadoPor")
  negocio     Negocio       @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  codigosOtp  CodigoOtp[]
  movimentosOperados MovimentacaoEstoque[] @relation("MovimentoOperador")
  ajustesOperados AjusteInventario[] @relation("AjusteOperador")

  @@unique([negocioId, id])
  @@index([negocioId, ativo])
  @@map("usuarios")
}

model SessaoUsuario {
  id          String    @id @default(uuid()) @db.Uuid
  negocioId   String    @map("negocio_id") @db.Uuid
  usuarioId   Int       @map("usuario_id")
  authVersion Int       @default(0) @map("auth_version")
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiraEm    DateTime  @map("expira_em") @db.Timestamptz(3)
  revogadaEm  DateTime? @map("revogada_em") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  negocio     Negocio   @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  usuario     Usuario   @relation(fields: [negocioId, usuarioId], references: [negocioId, id], onDelete: Restrict)

  @@unique([negocioId, id])
  @@index([usuarioId, expiraEm])
  @@index([negocioId, usuarioId, expiraEm])
  @@map("sessoes_usuarios")
}

model AuditoriaUsuario {
  id          BigInt    @id @default(autoincrement())
  negocioId   String    @map("negocio_id") @db.Uuid
  atorId      Int?      @map("ator_id")
  alvoId      Int?      @map("alvo_id")
  evento      String    @db.VarChar(50)
  detalhes    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  negocio     Negocio   @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  ator        Usuario?  @relation("AuditActor", fields: [negocioId, atorId], references: [negocioId, id], onDelete: Restrict)
  alvo        Usuario?  @relation("AuditTarget", fields: [negocioId, alvoId], references: [negocioId, id], onDelete: Restrict)

  @@index([alvoId, createdAt])
  @@index([negocioId, createdAt])
  @@map("auditoria_usuarios")
}

model LoginThrottle {
  chave         String    @id @db.Char(64)
  tentativas    Int       @default(0)
  janelaInicio  DateTime  @map("janela_inicio") @db.Timestamptz(3)
  bloqueadaAte  DateTime? @map("bloqueada_ate") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("login_throttles")
}

/// Guarda rótulos originais de categorias renomeadas durante a deduplicação case-insensitive.
model CategoriaNomeLegacy {
  negocioId   String   @map("negocio_id") @db.Uuid
  categoriaId  Int      @id @map("categoria_id")
  nomeOriginal String   @map("nome_original") @db.VarChar(100)
  nomeMigrado  String   @map("nome_migrado") @db.VarChar(100)
  migradoEm    DateTime @default(now()) @map("migrado_em")
  negocio      Negocio @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  categoria    CategoriaProduto @relation(fields: [negocioId, categoriaId], references: [negocioId, id], onDelete: Restrict)

  @@index([negocioId])
  @@map("categorias_nomes_legacy")
}

// ============================================================
// CATEGORIAS DE PRODUTOS
// Fonte: FadConecta_Kaua_Hedlund (2).docx + 0. Tabelas CRUD
// RN: nome único, inativação nunca exclui histórico
// ============================================================
model CategoriaProduto {
  id         Int       @id @default(autoincrement())
  negocioId  String    @map("negocio_id") @db.Uuid
  nome       String    @db.VarChar(100)
  ativo      Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Relacionamentos
  negocio    Negocio   @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  produtos   Produto[]
  nomesLegacy CategoriaNomeLegacy[]

  @@unique([negocioId, id])
  @@unique([negocioId, nome])
  @@index([negocioId, ativo])
  @@map("categorias_produtos")
}

model Cliente {
  id             Int       @id @default(autoincrement())
  negocioId      String    @map("negocio_id") @db.Uuid
  nome           String    @db.VarChar(150)
  whatsapp       String    @db.VarChar(16)
  instagram      String?   @db.VarChar(30)
  ativo          Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  criadoPorId    Int       @map("criado_por_id")
  atualizadoPorId Int?    @map("atualizado_por_id")
  negocio        Negocio   @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  criadoPor      Usuario   @relation("ClienteCriadoPor", fields: [negocioId, criadoPorId], references: [negocioId, id], onDelete: Restrict)
  atualizadoPor  Usuario? @relation("ClienteAtualizadoPor", fields: [negocioId, atualizadoPorId], references: [negocioId, id], onDelete: Restrict)
  vendas         Venda[]

  @@unique([negocioId, id])
  @@index([ativo, nome])
  @@index([whatsapp])
  @@map("clientes")
}

model Venda {
  id            Int          @id @default(autoincrement())
  negocioId     String       @map("negocio_id") @db.Uuid
  clienteId     Int          @map("cliente_id")
  usuarioId     Int          @map("usuario_id")
  dataPedido    DateTime     @map("data_pedido") @db.Date
  statusPagamento StatusPagamentoVenda @map("status_pagamento")
  vencimento    DateTime?    @db.Date
  observacoes   String?      @db.VarChar(1000)
  total         Decimal      @db.Decimal(12, 2)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  negocio       Negocio      @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  cliente       Cliente      @relation(fields: [negocioId, clienteId], references: [negocioId, id], onDelete: Restrict)
  usuario       Usuario      @relation(fields: [negocioId, usuarioId], references: [negocioId, id], onDelete: Restrict)
  itens         ItemVenda[]
  movimentacoes MovimentacaoEstoque[]

  @@unique([negocioId, id])
  @@index([clienteId, dataPedido])
  @@index([usuarioId, createdAt])
  @@index([statusPagamento, vencimento])
  @@map("vendas")
}

model ItemVenda {
  id             Int      @id @default(autoincrement())
  negocioId      String   @map("negocio_id") @db.Uuid
  vendaId        Int      @map("venda_id")
  produtoId      Int      @map("produto_id")
  nomeProduto    String   @map("nome_produto") @db.VarChar(255)
  quantidade     Int
  valorUnitario  Decimal  @map("valor_unitario") @db.Decimal(12, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
  negocio        Negocio  @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  venda          Venda    @relation(fields: [negocioId, vendaId], references: [negocioId, id], onDelete: Restrict)
  produto        Produto  @relation(fields: [negocioId, produtoId], references: [negocioId, id], onDelete: Restrict)

  @@unique([negocioId, id])
  @@unique([vendaId, produtoId])
  @@unique([negocioId, vendaId, produtoId])
  @@index([produtoId])
  @@map("itens_venda")
}

// ============================================================
// PRODUTOS
// Fonte: Produtos_Levantamento_Eduardo.docx
//        Cadastrar Produtos - Requisitos Funcionais_.docx
//        0. Tabelas CRUD – resumo
// DIVERGÊNCIAS SINALIZADAS:
//   - fornecedor_id: RF diz obrigatório, Eduardo diz opcional
//     → Implementado como OPCIONAL (a confirmar pela equipe)
//   - data_validade: Eduardo marca "a validar pela equipe"
//     → Implementado como campo opcional
// ============================================================
model Produto {
  id               Int               @id @default(autoincrement())
  negocioId        String            @map("negocio_id") @db.Uuid
  nome             String            @db.VarChar(255)
  /// Categoria obrigatória conforme RN-CAT-01
  categoriaId      Int               @map("categoria_id")
  unidadeMedida    String            @default("UNIDADE") @map("unidade_medida") @db.VarChar(50)
  /// RN-07: preço de custo não pode ser nulo
  precoCusto       Decimal           @map("preco_custo") @db.Decimal(15, 2)
  /// RN-07: preço de venda não pode ser nulo
  precoVenda       Decimal           @map("preco_venda") @db.Decimal(15, 2)
  /// Quantidade atual em estoque (atualizada por movimentações)
  quantidadeEstoque Decimal          @default(0) @map("quantidade_estoque") @db.Decimal(10, 2)
  /// RN-07: estoque mínimo não pode ser nulo
  estoqueMinimo    Decimal           @map("estoque_minimo") @db.Decimal(10, 2)
  /// Fornecedor OPCIONAL — DIVERGÊNCIA: RF-01 RN-04 diz existente,
  /// Eduardo e resumo dizem não obrigatório (produção própria)
  /// → Implementado como nullable. Equipe deve confirmar.
  fornecedorId     Int?              @map("fornecedor_id")
  /// Campo opcional — Eduardo marca "a validar pela equipe"
  dataValidade     DateTime?         @map("data_validade") @db.Date
  ativo            Boolean           @default(true)
  observacoes      String?           @db.Text
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  // Relacionamentos
  negocio          Negocio           @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  categoria        CategoriaProduto @relation(fields: [negocioId, categoriaId], references: [negocioId, id], onDelete: Restrict)
  movimentacoes    MovimentacaoEstoque[]
  ajustes          AjusteInventario[]
  itensVenda        ItemVenda[]

  @@unique([negocioId, id])
  @@unique([negocioId, nome])
  @@index([negocioId, ativo])
  @@map("produtos")
}

// ============================================================
// MOVIMENTAÇÕES DE ESTOQUE (Entrada e Saída)
// Fonte: Entrada_Saída_de_Mercadorias-Gledson.docx
//        DDL Fadconecta Geral.docx (movimentacoes_mercadorias)
// RN-MOV-01: saída não pode ultrapassar saldo atual
// RN-MOV-02: registra automaticamente usuário, data e hora
// NOTA: RN-MOV-03 (suporte offline) = PROPOSTA NÃO CONFIRMADA
// ============================================================
model MovimentacaoEstoque {
  id               Int              @id @default(autoincrement())
  negocioId        String           @map("negocio_id") @db.Uuid
  /// ENTRADA ou SAIDA
  tipoMovimento    TipoMovimento    @map("tipo_movimento")
  produtoId        Int              @map("produto_id")
  quantidade       Decimal          @db.Decimal(10, 2)
  /// ID do usuário operador (referência a tabela usuarios — fora do escopo desta entrega)
  operadorId       Int?             @map("operador_id")
  /// NF, Pedido, OS — opcional conforme Gledson
  documentoOrigem  String?          @map("documento_origem") @db.VarChar(100)
  observacoes      String?          @db.Text
  vendaId          Int?             @map("venda_id")
  dataHora         DateTime         @default(now()) @map("data_hora")

  // Relacionamentos
  negocio          Negocio          @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  produto          Produto          @relation(fields: [negocioId, produtoId], references: [negocioId, id])
  venda            Venda?           @relation(fields: [negocioId, vendaId], references: [negocioId, id], onDelete: Restrict)
  operador         Usuario?         @relation("MovimentoOperador", fields: [negocioId, operadorId], references: [negocioId, id], onDelete: Restrict)

  @@unique([negocioId, id])
  @@index([negocioId, produtoId, dataHora])
  @@map("movimentacoes_estoque")
}

// ============================================================
// AJUSTES E INVENTÁRIO
// Fonte: FADConecta_Ajustes_e_Invent_Sthefane.docx
//        DDL Fadconecta Geral.docx (ajustes_inventario)
// NOTA: diferença armazenada (redundância controlada p/ auditoria)
// ============================================================
model AjusteInventario {
  id                  Int          @id @default(autoincrement())
  negocioId           String       @map("negocio_id") @db.Uuid
  produtoId           Int          @map("produto_id")
  quantidadeSistema   Decimal      @map("quantidade_sistema") @db.Decimal(10, 2)
  quantidadeContada   Decimal      @map("quantidade_contada") @db.Decimal(10, 2)
  /// Calculado pelo sistema: contada - sistema
  diferenca           Decimal      @db.Decimal(10, 2)
  /// AUMENTO ou REDUCAO
  tipoAjuste          TipoAjuste   @map("tipo_ajuste")
  motivo              String       @db.Text
  data                DateTime     @default(now()) @db.Date
  /// ID do usuário responsável (ref. a tabela usuarios — fora do escopo desta entrega)
  usuarioResponsavelId Int?        @map("usuario_responsavel_id")
  observacoes         String?      @db.Text

  // Relacionamentos
  negocio             Negocio      @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  produto             Produto      @relation(fields: [negocioId, produtoId], references: [negocioId, id])
  usuarioResponsavel  Usuario?     @relation("AjusteOperador", fields: [negocioId, usuarioResponsavelId], references: [negocioId, id], onDelete: Restrict)

  @@unique([negocioId, id])
  @@index([negocioId, produtoId, data])
  @@map("ajustes_inventario")
}

// ============================================================
// ENUMS
// ============================================================

enum TipoMovimento {
  ENTRADA
  SAIDA

  @@map("tipo_movimento")
}

enum TipoAjuste {
  AUMENTO
  REDUCAO

  @@map("tipo_ajuste")
}

enum StatusPagamentoVenda {
  PAGO
  A_PRAZO

  @@map("status_pagamento_venda")
}

model CodigoOtp {
  id          String         @id @default(uuid()) @db.Uuid
  negocioId   String         @map("negocio_id") @db.Uuid
  usuarioId   Int            @map("usuario_id")
  finalidade  FinalidadeOtp
  hashCodigo  String         @map("hash_codigo") @db.Char(64)
  expiraEm    DateTime       @map("expira_em") @db.Timestamptz(3)
  tentativas  Int            @default(0)
  consumidoEm DateTime?      @map("consumido_em") @db.Timestamptz(3)
  envioPendente Boolean      @default(true) @map("envio_pendente")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  negocio     Negocio        @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  usuario     Usuario        @relation(fields: [negocioId, usuarioId], references: [negocioId, id], onDelete: Restrict)

  @@unique([negocioId, id])
  @@unique([negocioId, usuarioId, finalidade])
  @@map("codigos_otp")
}

model LimiteEnvioOtp {
  chave         String       @id @db.Char(64)
  finalidade    FinalidadeOtp
  envios        Int          @default(0)
  janelaInicio  DateTime     @map("janela_inicio") @db.Timestamptz(3)
  ultimoEnvio   DateTime     @map("ultimo_envio") @db.Timestamptz(3)
  falhasCodigo  Int          @default(0) @map("falhas_codigo")
  janelaFalhas  DateTime?    @map("janela_falhas") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("limites_envio_otp")
}
